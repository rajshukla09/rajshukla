<article class="book-feature">
    @if (!string.IsNullOrWhiteSpace(Book.Image))
    {
        <img class="book-cover" src="@Book.Image" alt="@Book.ImageAlt" loading="lazy" />
    }
    else
    {
        <div class="book-cover-placeholder" aria-hidden="true">
            <span>@Book.Title</span><strong>.NET</strong><small>Technical book</small>
        </div>
    }
    <div>
        <p class="eyebrow">@Book.Title</p>
        <h2>@Book.Subtitle</h2>
        <p>@Book.Description</p>
        <div class="actions">
            <a class="button primary" href="@Book.AmazonUrl" target="_blank" rel="noopener">View on Amazon</a>
            <a class="button" href="@Book.GitHubUrl" target="_blank" rel="noopener">Explore Source Code</a>
            <a class="text-link book-chapters-link" href="@($"books/{Book.Slug}")">Explore Chapters &amp; Articles →</a>
        </div>
    </div>
</article>

@code { [Parameter, EditorRequired] public BookItem Book { get; set; } = null!; }
