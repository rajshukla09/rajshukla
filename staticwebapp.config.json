{
  // This setting tells Azure Static Web Apps to rewrite all navigation requests
  // to `index.html`, which is common for single-page applications (SPA).
  "navigationFallback": {
    "rewrite": "/index.html", // Route all unmatched paths to `index.html`.

    // The `exclude` array prevents the rewrite for specific directories
    // where your static assets like images, CSS, and JS files are stored.
    // This ensures that requests to these files are not redirected to `index.html`
    // and can instead serve the actual static assets.
    "exclude": [
      "/images/*", // Excludes published images from rewrite.
      "/css/*", // Excludes all files in the `css` directory from rewrite.
      "/js/*", // Excludes JavaScript assets from rewrite.
      "/content/*" // Excludes static JSON and Markdown content from rewrite.
    ]
  }
}

