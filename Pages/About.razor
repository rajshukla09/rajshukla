@page "/about"
@inject ContentService Content

@if (profile is not null)
{
    <PageMetadata Title="About Raj Shukla" Description="@profile.Intro" Image="@profile.ProfileImage" />
    <article class="about-page">
        <header class="page-intro shell">
            <p class="eyebrow">About</p>
            <h1>Engineering intelligent systems for the real world.</h1>
        </header>
        <div class="about-body shell @(string.IsNullOrWhiteSpace(profile.ProfileImage) ? "without-image" : null)">
            @if (!string.IsNullOrWhiteSpace(profile.ProfileImage))
            {
                <img class="about-profile-image" src="@profile.ProfileImage" alt="@profile.ProfileImageAlt" />
            }
            <div class="about-copy">
                @foreach (var paragraph in profile.Biography) { <p>@paragraph</p> }
                <p><a href="@profile.GitHubUrl" target="_blank" rel="me noopener">GitHub</a> · <a href="@profile.LinkedInUrl" target="_blank" rel="me noopener">LinkedIn</a></p>
            </div>
        </div>
    </article>
}

@code {
    private SiteProfile? profile;
    protected override async Task OnInitializedAsync() => profile = await Content.GetProfileAsync();
}
