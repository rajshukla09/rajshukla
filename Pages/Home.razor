@page "/"
@inject ContentService Content

@if (profile is not null)
{
    <PageMetadata Title="@($"{profile.Name} — {profile.Title}")" Description="@profile.Intro" Image="@profile.ProfileImage" />
    <section class="hero shell">
        <div class="hero-content">
            <p class="eyebrow">@profile.Title</p>
            <h1>@profile.Name</h1>
            <p class="hero-lede">@profile.Intro</p>
            <div class="actions"><a class="button primary" href="articles">Read the writing</a><a class="text-link" href="books">Explore the books <span aria-hidden="true">→</span></a></div>
        </div>
    </section>
}

@if (books is not null)
{
    <section class="section home-section shell"><div class="section-heading"><p class="eyebrow">Selected work</p><h2>Featured Books</h2></div>
        <div class="book-compact-grid">
            @foreach (var book in books.Where(book => book.Featured))
            {
                <a href="@($"books/{book.Slug}")" class="book-compact"><div><strong>@book.Title</strong><p>@book.Subtitle</p></div></a>
            }
        </div>
    </section>
}

<section class="section home-section shell"><div class="section-heading split"><div><p class="eyebrow">Ideas in practice</p><h2>Selected Writing</h2></div><a class="text-link" href="articles">View all writing →</a></div>
    @if (articles is null) { <p>Loading writing…</p> } else { <ArticleList Articles="articles" /> }
</section>

@if (profile is not null)
{
    <section class="connect home-connect shell"><p class="eyebrow">Connect</p><h2>Follow the work.</h2><p>Find source code on <a href="@profile.GitHubUrl" target="_blank" rel="me noopener">GitHub</a> and professional updates on <a href="@profile.LinkedInUrl" target="_blank" rel="me noopener">LinkedIn</a>.</p></section>
}

@code {
    private SiteProfile? profile;
    private IReadOnlyList<BookItem>? books;
    private IReadOnlyList<ArticleSummary>? articles;

    protected override async Task OnInitializedAsync()
    {
        var profileTask = Content.GetProfileAsync();
        var booksTask = Content.GetBooksAsync();
        var articlesTask = Content.GetFeaturedArticlesAsync();
        await Task.WhenAll(profileTask, booksTask, articlesTask);
        profile = await profileTask;
        books = await booksTask;
        var featuredArticles = await articlesTask;
        articles = featuredArticles.Count > 0
            ? featuredArticles.Take(3).ToList()
            : await Content.GetRecentArticlesAsync(3);
    }
}
