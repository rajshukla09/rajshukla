@page "/books"
@inject ContentService Content

<PageMetadata Title="Books" Description="Books by Raj Shukla on building production-ready AI agents and advanced agentic workflows with .NET." />
<header class="page-intro shell"><p class="eyebrow">Technical books</p><h1>Building AI Agents with .NET</h1><p>A practical series about designing agentic systems in C#—from core patterns to production architecture.</p></header>
<section class="shell book-list">
    @if (books is null) { <p>Loading books…</p> }
    else { @foreach (var book in books) { <BookFeature Book="book" /> } }
</section>

@code {
    private IReadOnlyList<BookItem>? books;
    protected override async Task OnInitializedAsync() => books = await Content.GetBooksAsync();
}
